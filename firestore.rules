rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // كل مستخدم يقرأ ويكتب وثيقته فقط
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // كل ما عدا ذلك ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
